                    runtime: '0.795', serverId: TYTN8BQdkwxVWFYpZ64NZnS522Wkwcg8,
                    sql: "WITH engagements AS (select project_engagement_pk, engagement_code,\
                      \ company_fk, engagement_start_ts, engagement_end_ts, deal_id,\
                      \ deal_amount, deal_hourly_rate, deal_description, deal_name,\
                      \ deal_type, deal_partner_referral, deal_source, deal_days_to_close,\
                      \ last_billable_timesheet_date,deal_created_ts, dt_entered_3_sow_drafted,\
                      \ dt_entered_5_customer_agreed_sow, dt_entered_7_sow_customer_docusigned,\
                      \ deal_closed_ts, projects from analytics.timesheet_project_engagements_dim\n\
                      \        group by all )\nSELECT\n    companies_dim.company_name\
                      \  AS companies_dim_company_name,\n    ROUND(COALESCE(CAST(\
                      \ ( SUM(DISTINCT (CAST(ROUND(COALESCE( timesheet_project_engagement_timesheets_projects_dim.project_fee_amount\
                      \  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x',\
                      \ substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001\
                      \ )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(\
                      \ timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001)\
                      \ )  / (1/1000*1.0) AS NUMERIC), 0), 6) AS timesheet_project_engagement_timesheets_projects_dim_total_project_fee_amount,\n\
                      \    COALESCE(SUM(timesheet_project_engagement_recognized_revenue.consultant_recognized_revenue_gbp\
                      \ ), 0) AS timesheet_project_engagement_recognized_revenue_total_recognized_revenue_gbp,\n\
                      \        COALESCE(SUM(timesheet_project_engagement_recognized_revenue.consultant_delivery_labour_cost_gbp\
                      \ ), 0) + COALESCE(ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(\
                      \ timesheet_project_engagement_recognized_revenue.total_expense_cost_gbp\
                      \  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x',\
                      \ substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001\
                      \ )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(\
                      \ (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001)\
                      \ )  / (1/1000*1.0) AS NUMERIC), 0), 6), 0) AS timesheet_project_engagement_recognized_revenue_total_delivery_cost_gbp,\n\
                      \    ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(\
                      \ timesheet_project_engagement_timesheets_projects_dim.project_budget_amount\
                      \  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x',\
                      \ substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001\
                      \ )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(\
                      \ timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001)\
                      \ )  / (1/1000*1.0) AS NUMERIC), 0), 6) AS timesheet_project_engagement_timesheets_projects_dim_project_hours_budget,\n\
                      \    COALESCE(SUM(timesheet_project_engagement_recognized_revenue.consultant_hours_billed\
                      \ ), 0) AS timesheet_project_engagement_recognized_revenue_total_hours_billed,\n\
                      \    ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE(\
                      \ timesheet_project_engagement_recognized_revenue.total_expense_cost_gbp\
                      \  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x',\
                      \ substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001\
                      \ )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST(\
                      \ (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296\
                      \ + cast(cast(concat('0x', substr(to_hex(md5(CAST( (concat(timesheet_project_engagement_recognized_revenue.billing_month,timesheet_project_engagement_recognized_revenue.timesheet_project_pk))\
                      \   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001)\
                      \ )  / (1/1000*1.0) AS NUMERIC), 0), 6) AS timesheet_project_engagement_recognized_revenue_total_expense_cost_gbp,\n\
                      \    COALESCE(SUM(timesheet_project_engagement_recognized_revenue.consultant_delivery_labour_cost_gbp\
                      \ ), 0) AS timesheet_project_engagement_recognized_revenue_total_delivery_labour_cost_gbp\n\
                      FROM `analytics.companies_dim`  AS companies_dim\nLEFT JOIN\
                      \ engagements ON companies_dim.company_pk = engagements.company_fk\n\
                      LEFT JOIN UNNEST(engagements.projects) as timesheet_project_engagements_dim__projects\n\
                      LEFT JOIN `ra-development.analytics.recognized_revenue_fact`\
                      \  AS timesheet_project_engagement_recognized_revenue ON timesheet_project_engagements_dim__projects.timesheet_project_pk\
                      \ = timesheet_project_engagement_recognized_revenue.timesheet_project_pk\n\
                      LEFT JOIN `analytics.timesheet_projects_dim`\n     AS timesheet_project_engagement_timesheets_projects_dim\
                      \ ON timesheet_project_engagements_dim__projects.timesheet_project_pk\
                      \ = timesheet_project_engagement_timesheets_projects_dim.timesheet_project_pk\n\
                      WHERE ((( timestamp(engagements.engagement_start_ts)  ) >= ((TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(),\
                      \ DAY), YEAR))) AND ( timestamp(engagements.engagement_start_ts)\
                      \  ) < ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(),\
                      \ DAY), YEAR)), INTERVAL 1 YEAR)))))) AND (timestamp(engagements.engagement_end_ts))\
                      \ >= ((TIMESTAMP_ADD(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY),\
                      \ INTERVAL -1 DAY)))\nGROUP BY\n    1\nORDER BY\n    1 DESC\n\
                      LIMIT 50", sqlExplain: !!null '', supportsPivotInDb: true, timezone: Europe/London,
