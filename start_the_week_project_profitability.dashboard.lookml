      expression: "${timesheet_project_engagement_timesheets_projects_dim.project_hours_budget}*${duration_elapsed}"
      label: Hours Budget To-Date
      value_format:
      value_format_name: decimal_0
      _kind_hint: measure
      table_calculation: hours_budget_to_date
      _type_hint: number
    - category: table_calculation
      expression: |-
        if(diff_days(${engagements.engagement_start_ts_date},now())/
        diff_days(${engagements.engagement_start_ts_date},${engagements.engagement_end_ts_date})>1,1,diff_days(${engagements.engagement_start_ts_date},now())/
        diff_days(${engagements.engagement_start_ts_date},${engagements.engagement_end_ts_date}))
      label: "% Duration Elapsed"
