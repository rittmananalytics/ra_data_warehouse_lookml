      _type_hint: number
      is_disabled: true
    - category: table_calculation
      expression: sum(${recognised_revenue_to_date})
      label: Total Recognised Revenue
      value_format: '"£"0,"K"'
      value_format_name: __custom
      _kind_hint: measure
      table_calculation: total_recognised_revenue
      _type_hint: number
    - category: table_calculation
