        reverse: false
        stepped: false
      palette_id: looker_2026_categorical_1
    modern2026: true
    show_sql_query_menu_options: false
    column_order: ["$$$_row_numbers_$$$", companies_dim.company_name, engagements.deal_name,
      engagements.engagement_start_ts_date, engagements.engagement_end_ts_date, recognised_revenue_to_date,
      timesheet_project_engagement_timesheets_projects_dim.project_hours_budget, duration_elapsed,
      hours_budget_to_date, timesheet_project_engagement_recognized_revenue.total_hours_billed,
      hours_budget, timesheet_project_engagement_recognized_revenue.total_delivery_cost_gbp,
      project_margin, hourly_rate_to_date]
    show_totals: true
    show_row_totals: true
    truncate_header: false
    minimum_column_width: 75
    series_cell_visualizations:
