- dashboard: project_profitability
  title: Project Profitability
  preferred_viewer: dashboards-next
  style: modern
  crossfilter_enabled: true
  description: ''
  preferred_slug: Figo2D4Cq2CEPvL0ufvLRl
  theme_name: ''
  layout_granularity: granular
  layout: newspaper
  tabs:
  - name: ''
    label: ''
  elements:
  - title: Engagement Financials
    name: Engagement Financials
    model: analytics
    explore: companies_dim
    type: looker_grid
    fields: [engagements.engagement_start_ts_date, companies_dim.company_name, engagements.deal_name,
      engagements.engagement_end_ts_date, timesheet_project_engagement_timesheets_projects_dim.total_project_fee_amount,
      timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp,
      timesheet_project_engagement_recognized_revenue.total_delivery_cost_gbp, timesheet_project_engagement_timesheets_projects_dim.project_hours_budget,
      timesheet_project_engagement_recognized_revenue.total_hours_billed, timesheet_project_engagement_recognized_revenue.total_expense_cost_gbp,
      timesheet_project_engagement_recognized_revenue.total_delivery_labour_cost_gbp]
    filters:
      engagements.engagement_start_ts_date: 1 years
      engagements.engagement_end_ts_date: after 1 days ago
    sorts: [companies_dim.company_name desc]
    limit: 500
    column_limit: 50
    total: true
    dynamic_fields:
    - category: table_calculation
      expression: "(${timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp}-${timesheet_project_engagement_recognized_revenue.total_delivery_cost_gbp})/${timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp}"
      label: Project Margin %
      value_format:
      value_format_name: percent_0
      _kind_hint: measure
      table_calculation: project_margin
      _type_hint: number
    - category: table_calculation
      expression: "${timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp}"
      label: Recognised Revenue To-Date
      value_format:
      value_format_name: gbp_0
      _kind_hint: measure
      table_calculation: recognised_revenue_to_date
      _type_hint: number
    - category: table_calculation
      expression: "(${recognised_revenue_to_date}-${timesheet_project_engagement_recognized_revenue.total_delivery_cost_gbp})/${recognised_revenue_to_date}"
      label: Project Margin % To-Date
      value_format:
      value_format_name: percent_0
      _kind_hint: measure
      table_calculation: project_margin_to_date
      _type_hint: number
      is_disabled: true
    - category: table_calculation
      expression: "${recognised_revenue_to_date}/${timesheet_project_engagement_recognized_revenue.total_hours_billed}"
      label: Hourly Rate To-Date
      value_format:
      value_format_name: gbp_0
      _kind_hint: measure
      table_calculation: hourly_rate_to_date
      _type_hint: number
    - category: table_calculation
      expression: "${timesheet_project_engagement_timesheets_projects_dim.project_hours_budget}*${duration_elapsed}"
      label: Hours Budget To-Date
      value_format:
      value_format_name: decimal_0
      _kind_hint: measure
      table_calculation: hours_budget_to_date
      _type_hint: number
    - category: table_calculation
      expression: |-
        if(diff_days(${engagements.engagement_start_ts_date},now())/
        diff_days(${engagements.engagement_start_ts_date},${engagements.engagement_end_ts_date})>1,1,diff_days(${engagements.engagement_start_ts_date},now())/
        diff_days(${engagements.engagement_start_ts_date},${engagements.engagement_end_ts_date}))
      label: "% Duration Elapsed"
      value_format:
      value_format_name: percent_0
      _kind_hint: dimension
      table_calculation: duration_elapsed
      _type_hint: number
    - category: table_calculation
      expression: "${timesheet_project_engagement_recognized_revenue.total_hours_billed}/${hours_budget_to_date}"
      label: Hours / Budget %
      value_format:
      value_format_name: percent_0
      _kind_hint: measure
      table_calculation: hours_budget
      _type_hint: number
    - category: table_calculation
      expression: "${hourly_rate_to_date}/176"
      label: Hourly Rate / Budget %
      value_format:
      value_format_name: percent_0
      _kind_hint: measure
      table_calculation: hourly_rate_budget
      _type_hint: number
      is_disabled: true
    show_view_names: false
    show_row_numbers: true
    transpose: false
    truncate_text: true
    hide_totals: false
    hide_row_totals: false
    size_to_fit: true
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: true
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    conditional_formatting_include_totals: false
