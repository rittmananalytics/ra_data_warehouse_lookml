    - category: table_calculation
      expression: "(${timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp:total}-${timesheet_project_engagement_recognized_revenue.total_delivery_cost_gbp:total})/${timesheet_project_engagement_recognized_revenue.total_recognized_revenue_gbp:total}"
      label: Avg. Project Margin
